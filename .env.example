# Copy to .env and edit. Only ORIGIN and UPSTREAM_URL are required.
# Loaded automatically when running from source; in Docker, pass these as
# environment variables instead.

# ---- required -----------------------------------------------------------

# The exact public address people open: scheme + host (+ port), no path,
# no trailing slash. WebAuthn checks it on every sign-in, so it must match
# character for character.
ORIGIN=https://app.example.com

# Where authenticated traffic goes, as reachable from the gate (e.g. the
# app's Compose service name and port).
UPSTREAM_URL=http://app:8080

# ---- optional -----------------------------------------------------------

# Name on the login page; also the default RP_NAME.
APP_NAME=My App

# Relying-party ID passkeys are bound to. Defaults to ORIGIN's hostname.
# May be a parent domain (example.com) so one passkey works across
# subdomains — but each gate instance still has its own users. Changing
# it later invalidates every registered passkey.
# RP_ID=app.example.com

# Name shown in the browser's passkey prompt. Defaults to APP_NAME.
# RP_NAME=My App

# Signs session cookies. Leave empty to have one generated on first start
# and kept in DATA_DIR/session-secret. If you set it: openssl rand -hex 32.
# Changing it signs everyone out.
SESSION_SECRET=

# Days a sign-in lasts (absolute, from sign-in).
SESSION_TTL_DAYS=30

# Default lifetime of invite links from `passkey-gate invite`.
INVITE_TTL_HOURS=72

# Reverse proxies in front of the gate (Nginx, Caddy, Traefik, cloudflared…).
# Decides which X-Forwarded-For entry is the real client and whether
# X-Forwarded-Proto is believed. Use the real number: too low and Secure
# cookies are never set (sign-in loops); too high and clients can fake
# their IP past the rate limiter.
TRUST_PROXY=1

# Path prefix for the gate's own pages and API, chosen so it can't collide
# with the app's routes.
GATE_PREFIX=/__passkey

# Comma-separated path prefixes proxied WITHOUT a session — for things that
# can't sign in: webhooks, health checks, public share links. A trailing
# "/" matches everything under it; without one, the path itself and its
# subpaths. Matching is case-sensitive and fails closed on "..", encoded
# slashes and backslashes.
# PUBLIC_PATHS=/webhook/,/healthz

# Send the signed-in username to the upstream in this header (for apps
# with trusted-header SSO). Any client-supplied value is always stripped.
# UPSTREAM_USER_HEADER=X-Remote-User

# Listen port and address (HOST: leave unset in Docker; 127.0.0.1 on a
# bare host behind a local reverse proxy).
PORT=3000
# HOST=127.0.0.1

# Only for local testing over plain http://localhost.
# COOKIE_SECURE=false
