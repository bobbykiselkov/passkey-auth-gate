{
  "name": "passkey-gate",
  "version": "1.0.0",
  "private": true,
  "description": "Passkey (WebAuthn) authentication reverse proxy for any self-hosted web app",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.client.json && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/server.js",
    "cli": "node dist/cli.js",
    "dev": "concurrently -k -n client,server -c magenta,green \"vite build --watch --mode development\" \"tsx watch src/server.ts\"",
    "test": "vite build && node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "http-proxy-middleware": "^4.2.0"
  },
  "devDependencies": {
    "@levischuck/tiny-cbor": "^0.3.6",
    "@simplewebauthn/browser": "^14.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12",
    "ws": "^8.22.0"
  }
}
